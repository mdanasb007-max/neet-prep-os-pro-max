<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Working Checkbox image button -->
    <ImageView
        android:id="@+id/widget_item_checkbox"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Toggle Task"
        android:src="@drawable/ic_widget_check_off" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="11th Physics"
            android:textColor="#F1F5F9"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="60 Qs • 120 mins"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PENDING"
        android:textColor="#F59E0B"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
